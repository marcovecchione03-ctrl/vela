{
  "name": "vela",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "check:production": "node --experimental-strip-types --env-file=.env scripts/check-production.ts"
  },
  "engines": {
    "node": ">=20.x"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-auth": "4.24.15",
    "postcss": "^8.5.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "^2.6.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.3",
    "web-push": "^3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "6.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  }
}
